{
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "globals": {
    "Sortable": "readonly",
    "html2canvas": "readonly",
    "JSZip": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "semi": ["error", "always"]
  }
}
